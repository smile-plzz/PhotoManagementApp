<!-- MainWindow.xaml -->
<Window x:Class="PhotoManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoManagementApp"
        mc:Ignorable="d"
        Title="Photo Management App" Height="768" Width="1024">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/> <!-- Folder Navigation -->
            <ColumnDefinition Width="*"/>  <!-- Photo Thumbnails -->
            <ColumnDefinition Width="250"/> <!-- Preview/Details Pane -->
        </Grid.ColumnDefinitions>

        <!-- Folder Navigation Pane -->
        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0">
            <DockPanel Margin="5">
                <Button Content="Select Folder" DockPanel.Dock="Top" Margin="0,0,0,5" Click="SelectFolder_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="FolderTreeView" SelectedItemChanged="FolderTreeView_SelectedItemChanged">
                        <!-- Folder structure will be dynamically loaded here -->
                    </TreeView>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Photo Thumbnails Area -->
        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,1,0">
            <StackPanel Margin="5">
                <TextBlock Text="Photos" FontWeight="Bold" Margin="0,0,0,5"/>
                <DockPanel Margin="0,0,0,5">
                    <Button Content="Search" DockPanel.Dock="Right" Click="SearchButton_Click"/>
                    <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="SortComboBox" Width="120" SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Filename" IsSelected="True"/>
                        <ComboBoxItem Content="Date Taken"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="YearComboBox" Width="100" SelectionChanged="YearComboBox_SelectionChanged"/>
                    <Button Content="Show All Photos" Margin="10,0,0,0" Click="ShowAllPhotos_Click"/>
                </StackPanel>
                <!-- Placeholder for ItemsControl or ListView for photo thumbnails -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PhotoItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"/> <!-- Adjust Columns as needed -->
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="100" Height="100" BorderBrush="Gray" BorderThickness="1" Margin="2">
                                    <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" Tag="{Binding FullPath}" MouseLeftButtonUp="ThumbnailImage_MouseLeftButtonUp"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Preview/Details Pane -->
        <Border Grid.Column="2">
            <StackPanel Margin="5">
                <TextBlock Text="Details" FontWeight="Bold" Margin="0,0,0,5"/>
                <!-- Placeholder for selected photo preview and metadata -->
                <Image x:Name="PreviewImage" Width="200" Height="150" Stretch="Uniform" Margin="0,0,0,10"/>
                <TextBlock x:Name="FileNameTextBlock" Text="Filename:" Margin="0,2"/>
                <TextBlock x:Name="DateTakenTextBlock" Text="Date Taken:" Margin="0,2"/>
                <TextBlock x:Name="CameraTextBlock" Text="Camera:" Margin="0,2"/>
                <TextBlock x:Name="TagsTextBlock" Text="Tags:" Margin="0,2"/>
                <!-- More details will be dynamically loaded here -->
            </StackPanel>
        </Border>
    </Grid>
</Window>