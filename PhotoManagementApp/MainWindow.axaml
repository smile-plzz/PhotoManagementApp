<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PhotoManagementApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:Class="PhotoManagementApp.MainWindow"
        Title="Photo Management App"
        x:DataType="vm:MainWindowViewModel">
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/> <!-- Folder Navigation -->
            <ColumnDefinition Width="*"/>  <!-- Photo Thumbnails -->
            <ColumnDefinition Width="250"/> <!-- Preview/Details Pane -->
        </Grid.ColumnDefinitions>

        <!-- Folder Navigation Pane -->
        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0">
            <DockPanel Margin="5">
                <Button Content="Select Folder" DockPanel.Dock="Top" Margin="0,0,0,5" Command="{Binding SelectFolderCommand}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="FolderTreeView" ItemsSource="{Binding Folders}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Subfolders}">
                                <TextBlock Text="{Binding Name}"/>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Photo Thumbnails Area -->
        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,1,0">
            <StackPanel Margin="5">
                <TextBlock Text="Photos" FontWeight="Bold" Margin="0,0,0,5"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="100" Height="100" BorderBrush="Gray" BorderThickness="1" Margin="2">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Preview/Details Pane -->
        <Border Grid.Column="2">
            <StackPanel Margin="5">
                <TextBlock Text="Details" FontWeight="Bold" Margin="0,0,0,5"/>
                <!-- Placeholder for selected photo preview and metadata -->
                <Image Source="{Binding SelectedImage.Thumbnail}" Width="200" Height="150" Stretch="Uniform" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SelectedImage.FullPath}" Margin="0,2"/>
                <TextBlock Text="Date Taken: N/A" Margin="0,2"/>
                <TextBlock Text="Camera: N/A" Margin="0,2"/>
                <TextBlock Text="Tags: N/A" Margin="0,2"/>
                <!-- More details will be dynamically loaded here -->
            </StackPanel>
        </Border>
    </Grid>
</Window>